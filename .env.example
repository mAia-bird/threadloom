# Threadloom configuration — copy to ".env" and fill in, OR just run the wizard:
#     python run.py setup
# The wizard fills all of this for you (and validates the tokens). This file is
# only a reference. Never commit your real .env — it holds secrets.

# UI + bot language: en or ru
LANG_UI=en

# --- Telegram (required) ---------------------------------------------------
# Bot token from @BotFather (/newbot).
TELEGRAM_TOKEN=
# Your numeric Telegram user ID — only this account may drive the bot.
OWNER_ID=

# --- Meta Threads (required to publish) ------------------------------------
# Access token for your Threads account, and your Threads user ID.
# The wizard discovers THREADS_USER_ID automatically from the token.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Optional: a closing post appended to every thread (e.g. a link to your channel).
# Must be <= 500 characters. Leave empty for none.
THREADS_CTA=

# --- Optional: bring your own AI model for smarter splitting ----------------
# Off by default; the built-in splitter needs none of this.
LLM_ENABLED=false
# "openai" (any OpenAI-compatible endpoint: OpenAI, OpenRouter, Ollama, LM Studio…)
# or "anthropic".
LLM_PROVIDER=openai
# OpenAI-compatible base URL. For a local Ollama server: http://localhost:11434/v1
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
# e.g. gpt-4o-mini, llama3.1, claude-haiku-4-5
LLM_MODEL=
